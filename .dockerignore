# VCS metadata — not needed inside the image
.git/

# Python artifacts — (re)built inside the container
**/__pycache__/
**/*.pyc
**/.venv/
**/dist/
**/*.egg-info/

# Upstream bits the image build never reads (keeps the context lean);
# pyproject.toml embeds README.md + LICENSE, setup.py compiles
# python/freetoken/** and freetoken-kernel-cache/ — those all stay.
FreeToken/.github/
FreeToken/tests/
FreeToken/docs/
FreeToken/assets/
FreeToken/benchmarks/
FreeToken/scripts/

# Secrets must never enter the build context or image layers
.env

# Host-side bind-mount content (engine scratch workspace / local checkpoints)
workspace/
models/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store