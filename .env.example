# Pi Agent Harness configuration template.
# Copy this file to .env and fill in your API keys.

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Pi Runtime Settings (optional overrides)
# -----------------------------------------------------------------------------

# Override the Pi config directory (default: ~/.pi/agent inside the container)
# PI_CODING_AGENT_DIR=

# Disable Pi startup network operations (update checks, package update checks,
# telemetry). Set to "true" for fully offline operation.
# PI_OFFLINE=
