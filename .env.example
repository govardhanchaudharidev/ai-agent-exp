# =============================================================================
# FreeToken configuration — SAMPLE
#
# Copy to .env and edit:
#     cp .env.example .env
#
# Read by docker-compose.yml and entrypoint.sh. Exactly one thing matters:
# FT_MODEL; everything else has sane defaults.
# =============================================================================

# What to serve: a Hugging Face repo id, OR a local checkpoint directory in
# ./models referenced as /models/<name>. A local checkpoint must be a full HF
# directory (config.json + *.safetensors + tokenizer) — single-file GGUFs are
# NOT supported by this engine (see README "Limitations").
#
# Pick per your host RAM: MoE offload pins ALL expert weights in system memory,
# so RAM — not VRAM — is usually the binding constraint. Rough guide:
#
#   FT_MODEL value                        download  comfortable host RAM
#   ------------------------------------  --------  --------------------
#   openai/gpt-oss-20b                    ~13 GB    32 GB
#   Qwen/Qwen3.6-35B-A3B-FP8              ~35 GB    64 GB
#   Qwen/Qwen3.6-35B-A3B                  ~70 GB    96 GB
#   deepseek-ai/DeepSeek-V4-Flash-0731    (big-RAM territory)
#
# Full known-good list: FreeToken/docs/models.md
FT_MODEL=openai/gpt-oss-20b

# Bind address/port inside the container (published on the host 1:1).
# The server binds 0.0.0.0 here instead of upstream's loopback default so the
# published port is reachable from the host.
FT_HOST=0.0.0.0
FT_PORT=1919

# Extra `ft serve` flags, word-split by entrypoint.sh (leave empty if none):
#   --gpu 1 --max-running-requests 2      pin a GPU on multi-GPU machines
#FT_SERVE_ARGS=

# Hugging Face token — only needed for gated checkpoints (e.g. Gemma).
# Create one at https://huggingface.co/settings/tokens
#HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# HOST_UID / HOST_GID: NOT set here on purpose — `make` exports them from your
# user automatically so bind-mounted files keep your ownership; plain
# `docker compose` falls back to 1000/1000.
# -----------------------------------------------------------------------------